rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthorized() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/usuariosAutorizados/$(request.auth.token.email));
    }

    match /portafolio/{proyectoId}/{filename=**} {
      allow read, write: if isAuthorized();
    }

    // Escaneos firmados y otros archivos de un proyecto del flujo (máx. 20 MB)
    match /proyectosFlujo/{proyectoId}/documentos/{filename=**} {
      allow read: if isAuthorized();
      allow write: if isAuthorized()
                   && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }
  }
}
